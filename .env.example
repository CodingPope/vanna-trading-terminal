# Import commands only. Export locally; never commit an actual key.
DATABENTO_API_KEY=

# Auto-loaded from this file by server/app/main.py (python-dotenv) and
# exposed by GET /api/fixtures. mode must match the loaded fixture manifest's
# own mode field, or startup fails loudly instead of silently falling back.
#
# If you point VANNA_FIXTURE at a real recorded fixture for local manual
# testing, the server test suite inherits it too -- `from app import main`
# runs this same dotenv load. Override both explicitly when running server
# tests locally so they stay hermetic regardless of what this file says:
#   VANNA_DATA_MODE=synthetic VANNA_FIXTURE= .venv/bin/python -m unittest discover -s tests
# CI is unaffected -- no .env file exists there.
VANNA_DATA_MODE=synthetic
VANNA_FIXTURE=
VANNA_ALLOW_MISSING_FIXTURE=false
