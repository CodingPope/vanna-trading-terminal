{
  "name": "vanna-trading-terminal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:server": "cd server && VANNA_DATA_MODE=synthetic VANNA_FIXTURE= .venv/bin/python -m unittest discover -s tests -v",
    "verify": "yarn lint && yarn test:run && yarn test:server && yarn build && yarn budget",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "benchmark": "playwright test -c playwright.benchmark.config.ts && node scripts/benchmark-report.mjs > docs/benchmarks/latest.md && node -e \"console.log(require('fs').readFileSync('docs/benchmarks/latest.md','utf8'))\"",
    "budget": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@reduxjs/toolkit": "^2.5.0",
    "@types/three": "^0.182.0",
    "ag-grid-community": "^35.1.0",
    "ag-grid-react": "^35.1.0",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hotkeys-hook": "^4.6.1",
    "react-redux": "^9.2.0",
    "recharts": "^2.15.4",
    "three": "^0.182.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^3"
  }
}
